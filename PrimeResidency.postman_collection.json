					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"admin@prime.com\",\n  \"password\": \"admin123\",\n  \"adminSecret\": \"PrimEResidency@2026@AdminSecret\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register-admin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register-admin"
							]
						},
						"description": "Creates an Admin user in the system. Requires `adminSecret` from the `.env` configuration file to prevent unauthorized signups."
					},
					"response": []
				},
				{
					"name": "Admin/Manager Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.token) {",
									"    if (jsonData.user.role === 'Admin') {",
									"        pm.collectionVariables.set('admin_token', jsonData.token);",
									"        console.log('Saved admin_token to collection variables.');",
									"    } else {",
									"        pm.collectionVariables.set('manager_token', jsonData.token);",
									"        console.log('Saved manager_token to collection variables.');",
									"    }",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@prime.com\",\n  \"password\": \"admin123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in either an Admin or a Manager. It returns a JWT token which gets automatically saved to the corresponding collection variables via the Test Script."
					},
					"response": []
				},
